{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "fingerprint",
          "ruleId",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "policyHash",
    "sourceHash",
    "entries"
  ],
  "additionalProperties": false
}
